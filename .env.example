# Ceragem CIOS — Environment template (Volume 13 Section 8)
# Copy to backend/.env for local development

APP_VERSION=1.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_TIMEZONE=America/New_York

# Local native default — run: make postgres-up && make migrate
DATABASE_URL=postgresql+psycopg2://cios:cios_dev_password@127.0.0.1:5432/cios
# DATABASE_POOL_SIZE=20
# DATABASE_MAX_OVERFLOW=40
# SQLite fallback (CI tests only):
# DATABASE_URL=sqlite:///./campaign_intelligence.db

# Upload pipeline (Phase 2)
UPLOAD_ASYNC=false
BULK_UPLOAD_MODE=false
BULK_UPLOAD_ROW_THRESHOLD=100000
BULK_UPLOAD_SKIP_RAW_ROWS=true
BULK_UPLOAD_SKIP_FULL_TRACE=true
BULK_UPLOAD_SKIP_VERSION_HISTORY=true
CUSTOMER_ANALYSIS_ONLY=false
WORKER_POLL_SECONDS=5

JWT_SECRET=cios-dev-secret-change-in-production
JWT_EXPIRE_MINUTES=30
AUTH_REQUIRED=false

UPLOAD_DIR=uploads
EXPORT_PATH=uploads
BACKUP_PATH=backups

CORS_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

# Performance — local native dev (see Makefile backend-fast)
SKIP_PHYSICAL_SCHEMA=true
DASHBOARD_CACHE_INVALIDATE_ON_STARTUP=false
OPPORTUNITY_SIMULATE_CACHE_ENABLED=false
OPPORTUNITY_SIMULATE_CACHE_TTL_SECONDS=300
RATE_LIMIT_MAX_REQUESTS=180

# Frontend (.env.local) — use Next.js proxy to avoid CORS preflight
# NEXT_PUBLIC_USE_API_PROXY=true
# Leave NEXT_PUBLIC_API_URL unset to use /api/v1 rewrite

SMTP_SERVER=
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL=
ALERT_SLACK_WEBHOOK=
ALERT_WEBHOOK_URL=

# Geo intelligence — Data Commons ZIP income fallback (missing ZIPs only)
# Trial key (quota-limited): https://docs.datacommons.org/api/rest/v2/index.html#authentication
DATACOMMONS_API_KEY=
DATACOMMONS_ZIP_INCOME_FALLBACK=true
