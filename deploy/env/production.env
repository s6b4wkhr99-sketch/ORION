# Production — Volume 13 Section 4
ENVIRONMENT=production
APP_VERSION=1.4.0
DEBUG=false
LOG_LEVEL=WARNING

DATABASE_URL=postgresql+psycopg2://cios:REPLACE_ME@postgres:5432/cios_prod
POSTGRES_USER=cios
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=cios_prod

JWT_SECRET=REPLACE_WITH_STRONG_SECRET
JWT_EXPIRE_MINUTES=30
AUTH_REQUIRED=true

UPLOAD_DIR=uploads
EXPORT_PATH=uploads
BACKUP_PATH=backups

CORS_ORIGINS=https://cios.company.com
NEXT_PUBLIC_API_URL=
HTTP_PORT=80

SMTP_SERVER=smtp.company.com
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL=ops@company.com
ALERT_SLACK_WEBHOOK=
ALERT_WEBHOOK_URL=
