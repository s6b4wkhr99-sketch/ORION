# Development — Volume 13 Section 4
ENVIRONMENT=development
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=DEBUG

DATABASE_URL=postgresql+psycopg2://cios:cios_dev_password@postgres:5432/cios
POSTGRES_USER=cios
POSTGRES_PASSWORD=cios_dev_password
POSTGRES_DB=cios

JWT_SECRET=cios-dev-secret-change-in-production
JWT_EXPIRE_MINUTES=30
AUTH_REQUIRED=false

UPLOAD_DIR=uploads
EXPORT_PATH=uploads
BACKUP_PATH=backups

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3002
NEXT_PUBLIC_API_URL=
HTTP_PORT=8080

SMTP_SERVER=
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL=
ALERT_SLACK_WEBHOOK=
ALERT_WEBHOOK_URL=

UPLOAD_ASYNC=true
BULK_UPLOAD_MODE=true
BULK_UPLOAD_ROW_THRESHOLD=100000
BULK_UPLOAD_SKIP_RAW_ROWS=true
BULK_UPLOAD_SKIP_FULL_TRACE=true
BULK_UPLOAD_SKIP_VERSION_HISTORY=true
CUSTOMER_ANALYSIS_ONLY=true
WORKER_POLL_SECONDS=5
