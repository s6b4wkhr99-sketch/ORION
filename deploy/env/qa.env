# QA — Volume 13 Section 4
ENVIRONMENT=qa
APP_VERSION=1.5.0
DEBUG=false
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg2://cios:cios_qa_password@postgres:5432/cios_qa
POSTGRES_USER=cios
POSTGRES_PASSWORD=cios_qa_password
POSTGRES_DB=cios_qa

JWT_SECRET=replace-with-qa-secret
JWT_EXPIRE_MINUTES=30
AUTH_REQUIRED=true

UPLOAD_DIR=uploads
EXPORT_PATH=uploads
BACKUP_PATH=backups

CORS_ORIGINS=http://localhost:8080
NEXT_PUBLIC_API_URL=
HTTP_PORT=8080

SMTP_SERVER=
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL=qa-alerts@company.com
ALERT_SLACK_WEBHOOK=
ALERT_WEBHOOK_URL=
