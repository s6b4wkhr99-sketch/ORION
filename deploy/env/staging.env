# Staging — Volume 13 Section 4
ENVIRONMENT=staging
APP_VERSION=1.1.2
DEBUG=false
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg2://cios:cios_staging_password@postgres:5432/cios_staging
POSTGRES_USER=cios
POSTGRES_PASSWORD=cios_staging_password
POSTGRES_DB=cios_staging

JWT_SECRET=replace-with-staging-secret
JWT_EXPIRE_MINUTES=30
AUTH_REQUIRED=true

UPLOAD_DIR=uploads
EXPORT_PATH=uploads
BACKUP_PATH=backups

CORS_ORIGINS=https://staging.cios.example.com
NEXT_PUBLIC_API_URL=
HTTP_PORT=8080

SMTP_SERVER=smtp.company.com
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL=ops@company.com
ALERT_SLACK_WEBHOOK=
ALERT_WEBHOOK_URL=
